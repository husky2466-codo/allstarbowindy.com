.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Logs / runtime
*.log
.cloudflared-local/

# Node (in case a build step is added later)
node_modules/
dist/
.cache/

# MCP scratch
.playwright-mcp/

# Raw Google Maps scrape (source-of-truth kept locally, not in repo — 29MB, 50 people-shots + uncurated dupes)
# Curated subset lives in public/img/reference/
public/uploads/gmaps-photos/

# Generated 3D models (regenerable intermediates, kept local — large binaries)
public/uploads/3d/
**/graphify-out/

# Session handoff docs — local-only, never committed (kept on disk for the next session)
docs/handoffs/

# Email drafts — local-only, never committed (working drafts, not project artifacts)
docs/Email Drafts/

# Claude Code local config + session state (lock files, etc.) — local-only
.claude/

# Sensitive/local artifacts moved OUT of the served public/ root (scraped photos,
# code-graph output, livescores screenshots+token). Never served, never committed.
_local-artifacts/

# Rendered diagram binaries (GIF/MP4). Kept on disk for local doc preview and as
# email attachments, but NOT committed — they bloat the repo. The Remotion source
# that generates them lives in a separate project. Docs reference them by path.
docs/assets/aws-diagrams/
